{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate.schema.json",
  "type": "object",
  "required": ["type", "geometry", "properties"],
  "properties": {
    "type": {"const": "Feature"},
    "geometry": {"type": ["object", "null"]},
    "properties": {
      "type": "object",
      "required": ["candidate_id", "producer_skill", "entity_type", "temporal", "score", "confidence", "sources", "warnings"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "producer_skill": {"type": "string", "minLength": 1},
        "entity_type": {"type": "string", "minLength": 1},
        "start": {"type": ["object", "null"]},
        "end": {"type": ["object", "null"]},
        "temporal": {
          "type": "object",
          "required": ["start", "end", "duration_minutes", "timezone", "precision"],
          "properties": {
            "start": {"type": ["string", "null"]},
            "end": {"type": ["string", "null"]},
            "duration_minutes": {"type": ["number", "null"], "minimum": 0},
            "timezone": {"type": ["string", "null"]},
            "precision": {"enum": ["observed", "scheduled", "estimated", "unknown"]}
          }
        },
        "score": {"type": "number"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sources": {"type": "array"},
        "warnings": {"type": "array"},
        "raw_reference": {"type": ["string", "null"]}
      }
    }
  }
}
