{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "type": "object",
  "required": ["workflow_id", "nodes", "constraints"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "region": {
      "type": ["object", "null"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "timezone": {"type": ["string", "null"]},
        "geometry": {"type": ["object", "null"]}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "capability", "producer_skill", "parameters", "entity_types"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "producer_skill": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "entity_types": {"type": "array", "items": {"type": "string"}},
          "selection": {"enum": ["one", "all"]},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "hard", "parameters"],
        "properties": {
          "type": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": ["string", "null"]},
          "hard": {"type": "boolean"},
          "parameters": {"type": "object"},
          "weight": {"type": "number", "minimum": 0}
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_candidates_per_node": {"type": "integer", "minimum": 1},
        "max_combinations": {"type": "integer", "minimum": 1},
        "max_runtime_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
