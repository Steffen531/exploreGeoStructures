{
  "$schema": "https://opencode.ai/config.json",

  // Standard-Modell für dieses Projekt (kostenlos)
  "model": "opencode/longcat-2.5-preview-free",

  // Primärer Agent für neue Sessions
  "default_agent": "build",

  // Projekt-spezifische Anweisungen
  "instructions": ["AGENTS.md"],

  // Skills: Zusätzliche Skill-Verzeichnisse
  "skills": [".opencode/skills"],

  // Formatierung nach Datei-Änderungen aktivieren
  "formatter": true,

  // Berechtigungsregeln. Reihenfolge zählt – die letzte passende Regel gewinnt.
  // Nicht geregelte Aktionen (read, edit, glob, grep, question, skill,
  // subagent) erlaubt die Grundpolicy ohnehin. Bewusst KEINE "read *"-Regel:
  // sie würde die .env-Nachfrage der Grundpolicy aufheben.
  "permissions": [
    // Web → nachfragen. Die Skill-Skripte holen OSM/GTFS-Daten selbst per
    // Python (requests/urllib); webfetch/websearch wird nur zum Scouten
    // neuer Datenquellen gebraucht → einmalig "Allow always" genügt.
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },

    // Pfade außerhalb des Projektverzeichnisses → nachfragen …
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    // … außer dem vorgefertigten OpenCode-Scratch-Verzeichnis
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },

    // Shell → Grundhaltung "nachfragen". Erlaubt ist genau das, was die
    // Skills ausführen: cd sowie die Python-Skripte (.venv/bin/python … .py),
    // relativ und absolut aufgerufen. pip, rm, git push & Co. bleiben unter
    // "ask" → bei Bedarf einmalig mit "Allow always" merken.
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python *.py *", "effect": "allow" },
    { "action": "shell", "resource": "*/.venv/bin/python *.py *", "effect": "allow" },

    // Code Mode (execute) → nachfragen; die Skills benötigen ihn nicht.
    { "action": "execute", "resource": "*", "effect": "ask" }
  ],

  // Dateien ignorieren, die keine Dateisystem-Updates auslösen sollen
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "coverage/**", ".git/**"]
  }
}
