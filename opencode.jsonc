{
  "$schema": "https://opencode.ai/config.json",

  // Standard-Modell für dieses Projekt (kostenlos)
  "model": "opencode/longcat-2.5-preview-free",

  // Primärer Agent für neue Sessions
  "default_agent": "build",

  // Projekt-spezifische Anweisungen
  "instructions": ["AGENTS.md"],

  // Formatierung nach Datei-Änderungen aktivieren
  "formatter": true,

  // Berechtigungsregeln
  "permissions": [
    // Datei-Operationen → immer fragen
    { "action": "read", "resource": "*", "effect": "ask" },
    { "action": "write", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "glob", "resource": "*", "effect": "ask" },
    { "action": "grep", "resource": "*", "effect": "ask" },

    // Ausführung & Automatisierung → immer fragen
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "execute", "resource": "*", "effect": "ask" },

    // Web & Browser → immer fragen
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "browser", "resource": "*", "effect": "ask" },

    // Andere Tools → automatisch erlauben
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "opencode", "resource": "*", "effect": "allow" }
  ],

  // Dateien ignorieren, die keine Dateisystem-Updates auslösen sollen
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "coverage/**", ".git/**"]
  }
}
