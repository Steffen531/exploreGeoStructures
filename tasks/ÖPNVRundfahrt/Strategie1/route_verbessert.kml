<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>ÖPNV-Rundfahrt Frankfurt (Strategie 1) - Reiseverlauf</name>
    <description>ÖPNV-Rundfahrt Frankfurt - Strategie 1: Achsen-Strategie + Zeitliche Optimierung</description>

    <!-- Stile für Linien -->
    <Style id="hinweg">
      <LineStyle>
        <color>ff009933</color>
        <width>6</width>
      </LineStyle>
    </Style>
    <Style id="rueckweg">
      <LineStyle>
        <color>ffFF6600</color>
        <width>6</width>
      </LineStyle>
    </Style>
    <Style id="faehre">
      <LineStyle>
        <color>ff0099FF</color>
        <width>6</width>
      </LineStyle>
    </Style>
    <Style id="umstieg">
      <IconStyle>
        <color>ffFF0000</color>
        <scale>1.5</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Style id="start">
      <IconStyle>
        <color>ff00FF00</color>
        <scale>1.5</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Style id="ziel">
      <IconStyle>
        <color>ffFF00FF</color>
        <scale>1.5</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/pink-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- Startpunkt -->
    <Placemark>
      <name>Start: Frankfurt Hbf</name>
      <description>Startpunkt der ÖPNV-Rundfahrt</description>
      <styleUrl>#start</styleUrl>
      <Point>
        <coordinates>8.68,50.11,0</coordinates>
      </Point>
    </Placemark>

    <!-- 1. Teilstrecke: S-Bahn S7/S8/S9 -->
    <Placemark>
      <name>1. S-Bahn S7/S8/S9</name>
      <description>Von: Frankfurt Hbf -> Nach: Frankfurt Ost
Dauer: 20 Minuten
Stationen: Frankfurt Hbf, Frankfurt Konstablerwache, Frankfurt Ostbahnhof</description>
      <styleUrl>#hinweg</styleUrl>
      <LineString>
        <coordinates>
          8.68,50.11,0
          8.69,50.11,0
          8.7,50.11,0
          8.71,50.12,0
          8.72,50.12,0
        </coordinates>
      </LineString>
    </Placemark>

    <!-- Umstiegspunkt 1 -->
    <Placemark>
      <name>Umstieg 1: Frankfurt Ost</name>
      <description>Umstieg von S-Bahn auf Straßenbahn</description>
      <styleUrl>#umstieg</styleUrl>
      <Point>
        <coordinates>8.72,50.12,0</coordinates>
      </Point>
    </Placemark>

    <!-- 2. Teilstrecke: Straßenbahn 11/12 -->
    <Placemark>
      <name>2. Straßenbahn 11/12</name>
      <description>Von: Frankfurt Ost -> Nach: Frankfurt Süd
Dauer: 35 Minuten
Stationen: Frankfurt Ost, Frankfurt Konstablerwache, Frankfurt Lokalbahnhof, Frankfurt Südbahnhof</description>
      <styleUrl>#rueckweg</styleUrl>
      <LineString>
        <coordinates>
          8.64,50.09,0
          8.65,50.1,0
          8.66,50.1,0
          8.67,50.11,0
          8.68,50.11,0
        </coordinates>
      </LineString>
    </Placemark>

    <!-- Umstiegspunkt 2 -->
    <Placemark>
      <name>Umstieg 2: Frankfurt Süd</name>
      <description>Umstieg von Straßenbahn auf Fähre</description>
      <styleUrl>#umstieg</styleUrl>
      <Point>
        <coordinates>8.68,50.09,0</coordinates>
      </Point>
    </Placemark>

    <!-- 3. Teilstrecke: Fähre -->
    <Placemark>
      <name>3. Fähre</name>
      <description>Von: Frankfurt Süd -> Nach: Frankfurt Höchst
Dauer: 30 Minuten
Stationen: Frankfurt Süd, Frankfurt Höchst</description>
      <styleUrl>#faehre</styleUrl>
      <LineString>
        <coordinates>
          8.68,50.09,0
          8.65,50.1,0
        </coordinates>
      </LineString>
    </Placemark>

    <!-- Endpunkt -->
    <Placemark>
      <name>Ziel: Frankfurt Höchst</name>
      <description>Endpunkt der ÖPNV-Rundfahrt</description>
      <styleUrl>#ziel</styleUrl>
      <Point>
        <coordinates>8.65,50.1,0</coordinates>
      </Point>
    </Placemark>

    <!-- Legende -->
    <Placemark>
      <name>Legende</name>
      <description>1. S-Bahn S7/S8/S9 (grün) - 20 Min
2. Straßenbahn 11/12 (orange) - 35 Min
3. Fähre (blau) - 30 Min
Gesamtdauer: 90 Minuten</description>
      <Point>
        <coordinates>8.68,50.11,0</coordinates>
      </Point>
    </Placemark>
  </Document>
</kml>